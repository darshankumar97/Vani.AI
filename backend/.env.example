# ==============================================================================
# SpeechCraft - Multilingual Expressive Offline TTS System Configuration
# ==============================================================================
# Copy this file to '.env' inside the backend/ directory to configure the application.
# All variables listed below are actively referenced by /backend/config.py.

# ------------------------------------------------------------------------------
# 1. Environment Profile
# ------------------------------------------------------------------------------
# Choices: "development" or "production"
# - development: Enables verbose debug prints and uncompiled local setups
# - production: Configured for memory-saving modes, high performance models and strict cache validation
ENV=development

# ------------------------------------------------------------------------------
# 2. FastAPI API Server Settings
# ------------------------------------------------------------------------------
# APP_NAME: Fully customized title displayed in FastAPI swagger/redoc documentation.
# APP_VERSION: Configured software version tag.
# HOST: Hostname bind interface. Use 127.0.0.1 for local lock or 0.0.0.0 for docker containers.
# PORT: Local bind port for API request routing.
APP_NAME="Multilingual Expressive TTS Core"
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 3. Neural Model & Execution Directory Configurations
# ------------------------------------------------------------------------------
# MODEL_DIR: Local folder hosting pre-trained offline XTTS-v2 files (checkpoint, config.json).
# XTTS_MODEL_NAME: Official Hugging Face ID of the model (downloaded automatically if online).
MODEL_DIR=./models
XTTS_MODEL_NAME="tts_models/multilingual/multi-dataset/xtts_v2"

# ------------------------------------------------------------------------------
# 4. CPU / GPU Execution & Accelerations Tuning
# ------------------------------------------------------------------------------
# TTS_DEVICE: Device executing PyTorch layers. Use "cuda" for NVIDIA GPUs, "cpu" for local Windows machines.
# USE_FP16: Casting to Float16 half precision. Reduces GPU memory (VRAM) footprint by ~50% & boosts speeds significantly.
TTS_DEVICE=cpu
USE_FP16=True

# ------------------------------------------------------------------------------
# 5. Threading Configurations for High-Concurrency CPU scaling
# ------------------------------------------------------------------------------
# INTRA_OP_THREADS: Number of CPU threads used for parallelizing single operators (e.g. matrix multiplication).
# INTER_OP_THREADS: Number of CPU threads used for parallelizing independent operations in the graph.
INTRA_OP_THREADS=4
INTER_OP_THREADS=2

# ------------------------------------------------------------------------------
# 6. Double-Tier Cache Memory Optimization Limits
# ------------------------------------------------------------------------------
# MEM_CACHE_MAX_ITEMS: Max number of synthesized audios held as binary streams directly in RAM (reduces I/O latency).
# CACHE_DIR: Relative path to disk storage for preserving audio cache files on disk.
# MAX_CACHE_SIZE_MB: Maximum disk space allowed for storage caching before LRU eviction triggers automatically.
MEM_CACHE_MAX_ITEMS=120
CACHE_DIR=./audio_cache
MAX_CACHE_SIZE_MB=1024

# ------------------------------------------------------------------------------
# 7. Voice Cloning Configuration Directories
# ------------------------------------------------------------------------------
# VOICEOVER_DIR: Local folder containing enrolled ".wav" reference vocal signatures for zero-shot voice cloning.
VOICEOVER_DIR=./voices


# ==============================================================================
# DEPLOYMENT PROFILE TEMPLATES
# ==============================================================================

# --- [DEVELOPMENT PROFILE PRESET] ---
# For lightweight local debugging on a standard CPU machine or laptop:
# ENV=development
# TTS_DEVICE=cpu
# USE_FP16=False
# INTRA_OP_THREADS=4
# INTER_OP_THREADS=2
# MEM_CACHE_MAX_ITEMS=20
# MAX_CACHE_SIZE_MB=256

# --- [PRODUCTION PROFILE PRESET] ---
# For fully optimized multi-user high capacity server with NVIDIA GPU support:
# ENV=production
# TTS_DEVICE=cuda
# USE_FP16=True
# INTRA_OP_THREADS=2   # Kept low because GPU overrides heavy maths
# INTER_OP_THREADS=2
# MEM_CACHE_MAX_ITEMS=500
# MAX_CACHE_SIZE_MB=5120 # 5GB high performance cache limit
